# Copy to .env.local and fill in. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (provider chosen in a later phase)
DATABASE_URL=

# Email - quote requests and inquiries
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
EMAIL_INQUIRIES_TO=

# File storage - product images, 3D models, customer logo uploads
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Admin authentication
AUTH_SECRET=
