# Copy to .env.local and fill in. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings > API in the Supabase dashboard).
# The URL and the anon key are safe to expose: the database's row level security limits what they can do.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row level security. Never prefix with NEXT_PUBLIC_, never commit, never paste into chat.
# Used only for creating employee logins.
SUPABASE_SERVICE_ROLE_KEY=

# Email and file storage integrations are optional and not wired up yet.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
